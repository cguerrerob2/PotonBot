# ==== DISCORD (required) ====
# Bot token (Discord Developer Portal -> Bot -> Token). Name the app "PotonCalled"
DISCORD_TOKEN=
# Channel ID for alerts (right-click channel -> Copy Channel ID, developer mode on)
DISCORD_CHANNEL_ID=
# Your Discord user ID so the bot pings you (right-click your profile -> Copy User ID)
DISCORD_PING_USER_ID=

# ==== OPTIONAL ====
# Solana RPC. The public one is slow/rate-limited; a free Helius key is recommended (https://helius.dev)
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Etherscan V2 API key (a single key works for ETH, BASE and BSC): https://etherscan.io/apis
# Only needed if you add EVM wallets (0x...) to wallets.json
ETHERSCAN_API_KEY=
